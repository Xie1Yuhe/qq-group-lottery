# 统一换行符；Windows 下的 .bat / .ps1 保持 CRLF 才能正常执行
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db binary
